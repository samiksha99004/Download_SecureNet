# ── Secrets — NEVER commit ──────────────────────────────────────────
.env
backend/.env
frontend/.env.local
*.neon-backup
*.key
*.pem

# ── Python ──────────────────────────────────────────────────────────
venv/
backend/venv/
__pycache__/
*.pyc
.pytest_cache/

